# Báo cho Git biết các file này là text để dễ so sánh (diff) và gộp (merge)
*.cs text diff=csharp
*.cginc text
*.shader text

# Tích hợp Unity Smart Merge (Nếu bạn hoặc team có cài)
*.unity merge=unityyamlmerge
*.prefab merge=unityyamlmerge

# --- CẤU HÌNH GIT LFS CHO CÁC FILE NẶNG (BINARY) ---

